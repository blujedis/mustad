{
  "name": "mustad",
  "version": "0.2.0",
  "description": "Pre and post hooks for functions such as node, mongodb etc.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "rimraf dist && tsc -b",
    "watch": "tsc -w",
    "start": "npm run watch",
    "typedoc": "typedoc ./src --options ./typedoc.json --out ./docs",
    "docs": "npm run typedoc && touch ./docs/.nojekll",
    "test": "mocha test/**/*.spec.ts* --require ./register.js --bail",
    "prep": "npm run build && npm run docs && npm run test"
  },
  "files": [
    "fixtures",
    "README.md",
    "dist"
  ],
  "keywords": [
    "hooks",
    "kareem",
    "promise-hooks",
    "node hooks",
    "before-after-hooks",
    "mustad"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "chai": "^6.0.1",
    "mocha": "^11.7.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.12",
    "typescript": "^5.9.2"
  }
}
